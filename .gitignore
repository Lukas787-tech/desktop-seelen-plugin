# Build output: regenerated by `npm run build` beside each metadata.yml.
widgets/*/index.js
widgets/*/index.css
widgets/*/index.html

# Offline module preview, built by `npm run preview`.
.preview/

# `slu resource bundle` drops its export beside the source it bundled.
themes/*/bundle *.yml

# Transpiled test input, regenerated by `npm test`.
.test/
